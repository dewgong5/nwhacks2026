# MarketMind Environment Configuration Example
# Copy this file to .env and populate with your own credentials if running in live mode.

# Operational mode: 'deterministic' (recommended for offline demo, no paid APIs) or 'live'
AI_MODE=deterministic

# Google Gemini API key (for live trading consultant chat)
# Required only if AI_MODE=live and using Gemini
GEMINI_API_KEY=

# OpenRouter API key (for live LLM trading agents)
# Required only if AI_MODE=live and using OpenRouter
OPENROUTER_API_KEY=

# Session signing secret (for production cookie / token security)
SESSION_SECRET=

# WebSocket admission and abuse bounds
WS_TICKET_TTL_SECONDS=60
WS_MAX_MESSAGE_BYTES=8192
WS_MAX_MESSAGES_PER_SECOND=10

# Server configuration
HOST=0.0.0.0
PORT=8000
